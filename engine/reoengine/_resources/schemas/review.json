{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review",
  "type": "object",
  "properties": {
    "approved": {
      "type": "boolean",
      "description": "The FSM treats approval as effective only when no findings have high or critical severity."
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": ["integer", "null"]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "line",
          "severity",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "approved",
    "summary",
    "findings"
  ],
  "additionalProperties": false
}
