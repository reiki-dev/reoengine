{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "result",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "awaiting_human",
        "completed",
        "done",
        "failed",
        "stopped"
      ]
    },
    "base_sha": {
      "type": "string"
    },
    "head_sha": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "gates": {
      "type": "object",
      "properties": {
        "isolation": {
          "type": "string",
          "enum": ["env-only", "wrapper"]
        },
        "passed": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              },
              "exit_code": {
                "type": "integer"
              },
              "stdout_tail": {
                "type": "string"
              },
              "stderr_tail": {
                "type": "string"
              },
              "duration_ms": {
                "type": "integer"
              },
              "outcome": {
                "type": "string",
                "enum": ["pass", "assertion_failed", "infra_error", "timeout", "unknown"]
              }
            },
            "required": [
              "name",
              "passed",
              "exit_code",
              "stdout_tail",
              "stderr_tail",
              "duration_ms",
              "outcome"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "isolation",
        "passed",
        "checks"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": ["integer", "null"]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "line",
              "severity",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "approved",
        "summary",
        "findings"
      ],
      "additionalProperties": false
    },
    "attempts": {
      "type": "integer"
    },
    "stop_reason": {
      "type": "string",
      "enum": [
        "no_progress",
        "fix_loop_budget",
        "max_fix_rounds",
        "diff_too_large"
      ]
    },
    "usage_summary": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reasoning_output_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_output_tokens"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "run_id",
    "status",
    "base_sha",
    "head_sha",
    "changed_files",
    "warnings",
    "gates",
    "review",
    "attempts",
    "usage_summary",
    "artifacts"
  ],
  "additionalProperties": false
}
